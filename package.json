{
  "name": "@ai0x0/utils",
  "version": "0.7.0",
  "description": "AI0x0 utils",
  "keywords": [
    "ai0x0"
  ],
  "homepage": "https://github.com/ai0x0/utils",
  "bugs": {
    "url": "https://github.com/ai0x0/utils/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai0x0/utils.git"
  },
  "license": "MIT",
  "author": "AI0x0 <i@ai0x0.com>",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./es/index.js",
  "types": "./lib/index.d.ts",
  "//exports": "调用方写 `@ai0x0/utils/backend`，不要再写 `@ai0x0/utils/es/backend/index.js` —— 那是在指名道姓地引构建产物，等于把「有 es/ 和 lib/ 两套输出」这个内部细节焊进每一个 import。./es/* 与 ./lib/* 两条通配留着只为不打断已有调用方，新代码别用。",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./es/index.js",
      "default": "./lib/index.js"
    },
    "./backend": {
      "types": "./lib/backend/index.d.ts",
      "import": "./es/backend/index.js",
      "default": "./lib/backend/index.js"
    },
    "./backend/schemas": {
      "types": "./lib/backend/schemas/index.d.ts",
      "import": "./es/backend/schemas/index.js",
      "default": "./lib/backend/schemas/index.js"
    },
    "./backend/sqlite": {
      "types": "./lib/backend/sqlite/index.d.ts",
      "import": "./es/backend/sqlite/index.js",
      "default": "./lib/backend/sqlite/index.js"
    },
    "./backend/sqlite/schemas": {
      "types": "./lib/backend/sqlite/schemas/index.d.ts",
      "import": "./es/backend/sqlite/schemas/index.js",
      "default": "./lib/backend/sqlite/schemas/index.js"
    },
    "./eslint-config": "./eslint-config/index.js",
    "./eslint-config/*": "./eslint-config/*",
    "./eslint-rules": "./eslint-rules/index.js",
    "./eslint-rules/*": "./eslint-rules/*",
    "./es/*": "./es/*",
    "./lib/*": "./lib/*",
    "./SKILL.md": "./SKILL.md",
    "./.agents/*": "./.agents/*",
    "./package.json": "./package.json"
  },
  "files": [
    "es",
    "lib",
    "eslint-config",
    "eslint-rules",
    ".agents",
    "SKILL.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "father dev",
    "prepare": "husky install",
    "prepublishOnly": "npm run build",
    "release": "semantic-release",
    "start": "npm run docs:dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*": [
      "pretty-quick --staged"
    ],
    "*.{ts,tsx,js}": [
      "eslint",
      "tsc-files --noEmit"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@vitest/coverage-v8": "^2.1.9",
    "clean-package": "^2.2.0",
    "commitlint": "^20.5.0",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "eslint": "9",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "father": "^4.6.18",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "next": "^16.2.6",
    "next-rest-framework": "github:mushan0x0/next-rest-framework#pkg",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "remark-cli": "^12.0.1",
    "tsc-files": "^1.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^2.1.9",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "peerDependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "next": "^16.0.0",
    "next-rest-framework": "*",
    "zod": "^4.3.6"
  }
}
